# Supabase, used by the waitlist form and the live signup counter.
#
# Copy this file to .env.local and fill in the two values from your Supabase
# project (Project Settings > API). On Vercel, set them as Environment
# Variables for the Production, Preview and Development environments.
#
# Neither variable is prefixed NEXT_PUBLIC_, so both stay server-side only.
# The service role key bypasses RLS: it must never reach the browser.
# Paste it on a single line; a truncated key fails with 401 "Invalid API key".
#
# Expected table:
#
#   create table public.waitlist (
#     id         uuid primary key default gen_random_uuid(),
#     email      text not null unique,
#     experience text not null check (experience in ('never', 'dabbled', 'investing')),
#     created_at timestamptz not null default now()
#   );
#   alter table public.waitlist enable row level security;
#
# If the table already exists without the experience column:
#
#   alter table public.waitlist
#     add column experience text not null
#     check (experience in ('never', 'dabbled', 'investing'));
#
# No RLS policy is needed: the service role key bypasses RLS, and no anonymous
# client ever touches the table.

SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
